# xihe-lite 环境变量模板（全部为占位符，不含任何真实凭据）
#
# 说明：
#   · 本项目**不读取 .env 文件**，这里只是把可用的环境变量列清楚；
#     需要时用 start.bat / set（cmd）或 $env:NAME="..."（PowerShell）设置。
#   · 真正的配置都在 config.json 里；下面只有 4 个覆盖项，方便容器/CI 不改文件就跑。
#   · 任何密钥、口令、API Key 都不要写进本文件或 config.json —— 本项目不需要它们。

# 指定配置文件路径（默认 ./config.json）
XIHE_CONFIG=config.json

# 覆盖控制台端口（默认 18910）
XIHE_PORT=18910

# 覆盖打印后端：auto / win32 / dry-run
XIHE_BACKEND=auto

# 覆盖打印机（留空 = 用系统默认打印机 / 不探测网络）
XIHE_PRINTER_IP=
XIHE_PRINTER_NAME=
