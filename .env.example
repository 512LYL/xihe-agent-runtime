# ============================================================
# 环境变量配置示例（.env.example）
#
# 用法：复制为 .env，填入你自己的值。
#   PowerShell:  Copy-Item .env.example .env
#   ⚠️ .env 已在 .gitignore 中排除，**任何真实密钥都不得入库**。
#   ⚠️ 本文件只允许出现占位符。
# ============================================================

# ---- 沐曦云端 API（通道① 多源韧性对照项；本项目实证数据不取自该通道） ----
# 获取地址：https://developer.metax-tech.com/activities/5 （Gitee.AI 沐曦资源包）
MUXI_API_KEY=your_muxi_api_key_here
MUXI_PACKAGE_ID=your_package_id_here

# ---- 桥接器运行期数据根目录（日志 / 诊断快照 / 暂停任务） ----
# 不设置时默认落在 <repo>/.runtime
XIHE_RUNTIME_ROOT=

# ---- 可选：额外的第三方包搜索路径（默认不添加任何本机路径） ----
XIHE_EXTRA_SITE_PACKAGES=

# ---- OpenClaw Gateway ----
# 状态目录（会话、配置）；请填你自己的路径
OPENCLAW_STATE_DIR=
# 会话目录（看护层扫描写锁卡死用）；留空则按 OPENCLAW_STATE_DIR 推导
OPENCLAW_SESSIONS_DIR=
# Gateway 端口
OPENCLAW_GATEWAY_PORT=18791
# openclaw.json 与本机 openclaw 安装路径（看护层拉起网关用）
OPENCLAW_JSON=
OPENCLAW_INDEX=
# Gateway 启动器（看护层在网关进程死亡时拉起它）
XIHE_GATEWAY_LAUNCHER=

# ---- 通道③：沐曦 C500 自部署 32B（vLLM，OpenAI 兼容） ----
# 本机经 SSH 隧道暴露的端口（隧道命令见 scripts/tunnel_c500.bat）
C500_LOCAL_PORT=18000
# 若不经隧道、直连实例内网地址，请填完整 base_url；公开仓库不得出现真实网关 IP
C500_BASE_URL=http://127.0.0.1:18000/v1
# vLLM 的 --served-model-name
C500_MODEL=xihe-32b
# 隧道建立所需的实例信息（仅本地 .env 保存，绝不入库）
#   C500_SSH_HOST / C500_SSH_PORT / C500_SSH_USER / C500_SSH_KEY
C500_SSH_HOST=
C500_SSH_PORT=
C500_SSH_USER=
C500_SSH_KEY=

# ---- 通道②：本地 Ollama 兜底 ----
OLLAMA_API=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=qwen3.5:4b

# ---- 通知（看护层告警用；不配则仅落日志，不发送） ----
XIHE_MAIL_ENV=

# ---- NapCat / QQ 入口（可选） ----
NAPCAT_WEBUI_TOKEN=
NAPCAT_LAUNCHER=
NAPCAT_FIX_WS=
NAPCAT_LOG_DIR=

# ---- 单主机多实例（开发用；看护层用于区分实例） ----
XIHE_INSTANCE_NAME=default
